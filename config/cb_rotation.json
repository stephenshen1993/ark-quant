{
  "strategy_name": "CB-MF-Rotation v1",
  "top_n": 20,
  "filters": {
    "max_cb_price": 130,
    "min_remaining_size_100m": 3,
    "min_turnover_yuan": 30000000,
    "min_years_to_maturity": 1,
    "exclude_call_risk": true,
    "exclude_st_stock": true
